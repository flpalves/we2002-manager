{
  "name": "we2002-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Manager de futebol que usa o Winning Eleven 2002 (PS1) como motor das partidas do usuário",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "build:app": "electron-vite build",
    "build": "electron-vite build && electron-builder --win",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "tokens": "node tools/gerar-tokens-css.mjs",
    "cheats": "node tools/gerar-cheats.mjs",
    "kits": "node tools/gerar-kits.mjs",
    "kits:desenhar": "tsx tools/desenhar-kit.ts",
    "bandeiras": "node tools/converter-bandeira.mjs",
    "pacote:gerar": "tsx tools/gerar-pacote-brasil.ts",
    "pacote:validar": "tsx tools/validar-pacote.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@node-rs/xxhash": "^1.7.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "jpeg-js": "^0.4.4",
    "pinia": "^4.1.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "vue-tsc": "^3.3.14"
  }
}
